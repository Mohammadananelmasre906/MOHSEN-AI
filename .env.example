# Generate a unique random value; never commit your real .env file.
MOHSEN_API_TOKEN=replace-with-a-long-random-secret
MOHSEN_DATABASE_PATH=~/.mohsen/data/mohsen.sqlite3

# Core and Admin must remain bound to localhost for this beta.
MOHSEN_CORE_HOST=127.0.0.1
MOHSEN_CORE_PORT=8765
MOHSEN_CORE_URL=http://127.0.0.1:8765
MOHSEN_ADMIN_HOST=127.0.0.1
MOHSEN_ADMIN_PORT=8766
